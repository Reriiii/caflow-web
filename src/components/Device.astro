---
interface Props {
  label: string;
  class?: string;
}

const { label, class: extra = "" } = Astro.props;
---
<div class={`device relative mx-auto w-[min(300px,76vw)] rounded-[2.9rem] bg-[#1d1d1d] p-[9px] ring-1 ring-white/15 shadow-[0_40px_120px_-30px_rgba(255,138,92,0.45)] ${extra}`} role="img" aria-label={label}>
  <div class="relative aspect-[9/19] overflow-hidden rounded-[2.35rem] bg-paper text-ink" aria-hidden="true">
    <div class="flex items-center justify-between px-6 pt-3 text-[11px] font-semibold tabular-nums">
      <span>9:41</span>
      <span class="h-5 w-20 rounded-full bg-ink"></span>
      <span class="flex items-center gap-1">
        <span class="h-2 w-3 rounded-sm bg-ink"></span>
        <span class="h-2 w-4 rounded-sm border border-ink"></span>
      </span>
    </div>
    <slot />
  </div>
</div>
