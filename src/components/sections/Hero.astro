---
import { CONTACT, type Copy } from "../../copy";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---
<section id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden pb-8 pt-24 md:pb-10 md:pt-28" data-hero>
  <div class="haze pointer-events-none absolute left-[62%] top-[46%] -z-20 h-[110vmax] w-[110vmax] -translate-x-1/2 -translate-y-1/2" data-hero-haze aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10" data-three="seal-particles" aria-hidden="true">
    <img src="/seal.svg" alt="" width="320" height="320" class="absolute left-[62%] top-[46%] h-[min(46vmin,420px)] w-[min(46vmin,420px)] -translate-x-1/2 -translate-y-1/2 -rotate-[4deg] opacity-90 drop-shadow-[0_0_60px_rgba(255,138,92,0.55)]" data-three-fallback />
  </div>
  <div class="mx-auto flex w-[min(1440px,calc(100%-32px))] flex-1 flex-col md:w-[calc(100%-64px)]">
    <p class="label flex items-center gap-3" data-hero-rise>
      <span class="inline-block h-2 w-2 rounded-full bg-ember shadow-[0_0_12px_3px_rgba(255,138,92,0.8)]" aria-hidden="true"></span>{t.hero.kicker}
    </p>
    <h1 class="poster mt-6 text-[clamp(3.6rem,13.2vw,15rem)] text-snow md:mt-10" data-split>
      <span class="block">{t.hero.lines[0]}</span>
      <span class="block pl-[8vw] text-ember">{t.hero.lines[1]}</span>
    </h1>
    <div class="mt-auto grid gap-8 pt-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-6 lg:col-span-5">
        <p class="max-w-[34rem] text-lg leading-relaxed text-pretty text-snow/85 md:text-xl" data-hero-rise>{t.hero.sub}</p>
        <p class="mt-4 flex items-center gap-3 text-sm font-semibold text-ash" data-hero-rise>
          <img src="/app-icon.svg" alt="" width="24" height="24" class="h-6 w-6 shrink-0 -rotate-[4deg] rounded-md" />{t.hero.fact}
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:col-span-6 md:justify-end lg:col-span-7" data-hero-rise>
        <a class="btn btn-ember w-full sm:w-auto" href={CONTACT.zaloHref} rel="noopener" data-magnetic>{t.cta}<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
        <a class="btn btn-ghost w-full sm:w-auto" href="#loop" data-magnetic>{t.hero.second}</a>
      </div>
    </div>
    <div class="mt-8 hidden items-center justify-between border-t border-line pt-4 md:flex" data-hero-rise>
      <span class="label flex items-center gap-3">
        <span class="relative block h-8 w-[1px] overflow-hidden bg-line" aria-hidden="true"><span class="absolute inset-x-0 top-0 h-3 bg-ember" data-scroll-cue></span></span>
        {t.hero.scroll}
      </span>
      <span class="label" translate="no">Zalo Mini App · VI / EN</span>
    </div>
  </div>
</section>
