---
import type { Copy } from "../../copy";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const spots = [
  "left-[1.5%] top-[20%] -rotate-3",
  "right-[1.5%] top-[15%] rotate-2",
  "left-[2%] bottom-[22%] rotate-1",
  "right-[2%] bottom-[28%] -rotate-2",
  "left-[30%] bottom-[5%] rotate-3",
  "right-[16%] bottom-[7%] -rotate-1",
];
---
<section id="problem" class="relative isolate overflow-clip" data-problem>
  <div class="relative flex min-h-[100svh] items-center py-24" data-problem-stage>
    <div class="pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
      {t.problem.fragments.map((item, index) => (
        <div class={`absolute w-max max-w-[16rem] rounded-2xl rounded-bl-md border border-line bg-smoke/90 px-4 py-2.5 ${spots[index]}`} data-fragment>
          <p class="flex items-center gap-2 text-xs text-ash"><span class="font-semibold text-snow/80">{item.who}</span><span class="tabular-nums">{item.time}</span></p>
          <p class="mt-0.5 text-sm text-snow/90">{item.text}</p>
        </div>
      ))}
    </div>
    <div class="relative mx-auto w-[min(980px,calc(100%-32px))]">
      <p class="label" data-rise>{t.problem.label}</p>
      <p class="mt-8 font-display text-[clamp(1.75rem,3.9vw,3.6rem)] font-semibold leading-[1.15] tracking-tight text-snow text-balance" data-problem-statement>{t.problem.statement}</p>
      <p class="poster mt-12 max-w-[18ch] text-[clamp(2.25rem,6vw,5.5rem)] text-ember [text-shadow:0_0_50px_rgba(255,138,92,0.4)]" data-problem-answer>{t.problem.answer}</p>
    </div>
  </div>
</section>
