---
import { CONTACT, type Copy } from "../copy";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const other = t.lang === "en" ? "vi" : "en";
const links = [
  ["problem", t.nav.problem],
  ["loop", t.nav.loop],
  ["live", t.nav.live],
  ["trust", t.nav.trust],
  ["try", t.nav.try],
  ["questions", t.nav.questions],
] as const;
---
<header class="fixed inset-x-0 top-0 z-50" data-nav>
  <div class="nav-ground pointer-events-none absolute inset-0 border-b border-white/0 opacity-0 transition-[opacity,border-color] duration-300 glass" data-nav-ground aria-hidden="true"></div>
  <nav class="relative mx-auto flex h-16 w-[min(1440px,calc(100%-32px))] items-center gap-2 md:h-20 md:w-[calc(100%-64px)]" aria-label="CaFlow">
    <a href="#main" class="skip">{t.skip}</a>
    <a href="#top" class="flex min-h-11 items-center" aria-label="CaFlow">
      <img src="/caflow-logo-horizontal-on-dark.svg" alt="CaFlow" width="128" height="36" class="h-8 w-auto md:h-9" />
    </a>
    <ul class="ml-auto hidden items-center xl:flex">
      {links.map(([id, label]) => <li><a class="navlink" href={`#${id}`} data-spy={id}>{label}</a></li>)}
    </ul>
    <a class="navlink ml-auto xl:ml-2" href={t.nav.otherHref} hreflang={other} lang={other} aria-label={t.nav.other}>{other.toUpperCase()}</a>
    <a class="btn btn-ember btn-sm hidden sm:inline-flex" href={CONTACT.zaloHref} rel="noopener" data-magnetic>{t.cta}</a>
    <button type="button" class="relative flex h-11 w-11 items-center justify-center rounded-full border border-line xl:hidden" aria-expanded="false" aria-controls="menu" data-menu-toggle data-open-label={t.nav.menu} data-close-label={t.nav.close} aria-label={t.nav.menu}>
      <span class="absolute h-px w-5 -translate-y-1 bg-snow transition-transform duration-300" data-menu-bar></span>
      <span class="absolute h-px w-5 translate-y-1 bg-snow transition-transform duration-300" data-menu-bar></span>
    </button>
  </nav>
  <span class="absolute inset-x-0 top-0 h-[2px] origin-left scale-x-0 bg-ember shadow-[0_0_12px_rgba(255,138,92,0.9)]" data-progress aria-hidden="true"></span>
  <div id="menu" class="fixed inset-0 -z-10 hidden flex-col justify-between bg-night px-4 pb-10 pt-24 xl:hidden" data-menu>
    <div class="haze pointer-events-none absolute left-1/2 top-1/3 h-[120vw] w-[120vw] -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
    <ul class="relative space-y-1">
      {links.map(([id, label], index) => (
        <li class="-mt-[0.4em] overflow-hidden pt-[0.45em] text-[clamp(2.75rem,12vw,5rem)]">
          <a class="poster flex min-h-14 items-baseline gap-4 text-[clamp(2.75rem,12vw,5rem)] text-snow" href={`#${id}`} data-menu-link>
            <span class="font-sans text-xs font-semibold tracking-[0.18em] text-ember">0{index + 1}</span>{label}
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn-ember relative w-full" href={CONTACT.zaloHref} rel="noopener">{t.cta}</a>
  </div>
</header>
